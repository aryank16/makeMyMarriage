# Supabase — Project Settings > Database > Connection string
#
# DATABASE_URL  = "Transaction pooler"  (port 6543)  — used by the app
# DIRECT_URL    = "Direct connection"   (port 5432)  — used by migrations
#
# These are NOT interchangeable. The pooler runs PgBouncer in transaction
# mode, which breaks Prisma migrations and prepared statements.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Google OAuth is built and wired on the login page, but the button stays
# inert until the Google provider is enabled in the Supabase dashboard AND a
# Google Cloud OAuth client exists with the Supabase callback URL registered.
# Set this to "true" only once both are done.
#
# Deliberately NOT prefixed NEXT_PUBLIC_: that would inline the value into the
# client bundle at build time, so changing it on a deployed app would do
# nothing until the next rebuild. The login page reads it per request instead.
GOOGLE_AUTH_ENABLED="false"

# Transactional email (organizer invitations). Resend's HTTP API is called
# directly — there is no SDK to install. Supabase's mailer is deliberately not
# used for this: it is for auth only and is capped at about two messages an
# hour for the whole project.
#
# Leave these blank and invitations still work — the membership is created and
# the person sees it when they sign in. Only the email is skipped, and the
# Organizers page says so rather than claiming it sent one.
#
# EMAIL_FROM must be on a domain verified with the provider, or every message
# is rejected. Until then use the provider's sandbox sender.
RESEND_API_KEY=""
EMAIL_FROM="MakeMyMarriage <invites@example.com>"

# Absolute base URL used in email links. Must be the public URL in production.
APP_URL="http://localhost:3000"
